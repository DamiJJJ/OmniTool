# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_RUN_PORT=8000

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# Database
# Development uses SQLite by default (no need to set DATABASE_URL)
# Production: Set DATABASE_URL to PostgreSQL connection string
DATABASE_URL=sqlite:///site.db

# API Keys - Get your own keys from respective services
# YouTube: https://console.cloud.google.com/
YOUTUBE_API_KEY=your-youtube-api-key-here

# Currency: https://www.exchangerate-api.com/
CURRENCY_API_KEY=your-currency-api-key-here

# OpenWeather: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key-here